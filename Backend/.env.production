# ═════════════════════════════════════════════════════════════════════════════
# DemandLead — Production Environment Configuration
# ═════════════════════════════════════════════════════════════════════════════
# 
# Copy this to .env on your production server and fill in your values.
# Never commit .env to version control.
#
# Quick Setup:
#   cp .env.production .env
#   php artisan key:generate
#   php artisan config:cache
#
# ═════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────

APP_NAME="DemandLead"
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.demandlead.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Use 'debug' only when troubleshooting

# ── Database (MySQL) ─────────────────────────────────────────────────────────

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demand_lead
DB_USERNAME=demand_lead_user
DB_PASSWORD=                      # Set a strong database password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Session ──────────────────────────────────────────────────────────────────

SESSION_DRIVER=redis              # Faster than 'file' or 'database'
SESSION_LIFETIME=120              # minutes
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.demandlead.io     # Allows subdomain sharing
SESSION_SECURE_COOKIE=true        # HTTPS only

# ── Queue & Cache (Redis) ────────────────────────────────────────────────────

QUEUE_CONNECTION=redis            # Use 'database' if Redis unavailable
CACHE_STORE=redis                 # Use 'file' if Redis unavailable

REDIS_CLIENT=phpredis             # Requires php-redis extension
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null               # Set if Redis has authentication
REDIS_PORT=6379

# Optional: Separate Redis databases per concern
REDIS_DB=0                        # General Redis operations
REDIS_CACHE_DB=1                  # Cache storage

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local             # Or 's3' for cloud storage

# ── Mail ─────────────────────────────────────────────────────────────────────

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org        # Or smtp.gmail.com, etc.
MAIL_PORT=587
MAIL_USERNAME=                    # Your SMTP username
MAIL_PASSWORD=                    # Your SMTP password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@demandlead.io"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://app.demandlead.io

# ── Sanctum (API Authentication) ─────────────────────────────────────────────

SANCTUM_STATEFUL_DOMAINS=app.demandlead.io
# Token expiration (in minutes, null = no expiration)
SANCTUM_TOKEN_EXPIRATION=null

# ── Horizon (Queue Dashboard) ────────────────────────────────────────────────

HORIZON_BASIC_AUTH_USERNAME=admin
HORIZON_BASIC_AUTH_PASSWORD=      # Set a strong password

# ── Demand Intelligence Engine ───────────────────────────────────────────────

DEMAND_REQUEST_DELAY_MS=1200      # ms delay between Google Trends requests
DEMAND_RISING_THRESHOLD=20        # % growth to classify as RISING
DEMAND_RAPID_THRESHOLD=50         # % growth to classify as RAPIDLY_RISING
DEMAND_SPIKE_THRESHOLD=100        # % growth to classify as SPIKE
DEMAND_DECLINING_THRESHOLD=-20    # % growth to classify as DECLINING
DEMAND_ALERT_MIN_SCORE=60         # Min opportunity score to fire alert

# ── Africa's Talking (SMS Provider) ──────────────────────────────────────────

AT_API_KEY=                       # Get from: https://africastalking.com
AT_USERNAME=                      # Your AT username (e.g., 'sandbox' for testing)

# ── OpenAI (AI-Powered Features) ─────────────────────────────────────────────

OPENAI_API_KEY=                   # Get from: https://platform.openai.com/api-keys
OPENAI_ORGANIZATION=              # Optional: Your org ID
OPENAI_MODEL=gpt-4o-mini          # Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MAX_TOKENS=500             # Max tokens per request
OPENAI_TEMPERATURE=0.7            # Creativity: 0.0-1.0 (lower = more focused)

# ── AWS S3 (Cloud File Storage - Optional) ───────────────────────────────────

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1     # Or your preferred region
AWS_BUCKET=demandlead-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Google Services ──────────────────────────────────────────────────────────

# Google Trends API (via SerpApi - Alternative provider)
SERPAPI_KEY=                      # Get from: https://serpapi.com

# Google Ads API (Optional - for keyword volume data)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Google Search Console API (Optional - for search analytics)
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=  # JSON credentials file path

# ── Super Admin Seed ─────────────────────────────────────────────────────────

# Used by: php artisan db:seed --class=SuperAdminSeeder
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@demandlead.io
SUPER_ADMIN_PASSWORD=             # Set a strong password (min 8 chars)

# ── Security & Rate Limiting ─────────────────────────────────────────────────

# API Rate Limits (requests per minute)
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5                 # Login/register attempts

# Session Security
SESSION_SAME_SITE=lax             # Options: lax, strict, none

# ── Optional Services ────────────────────────────────────────────────────────

# Pusher (Real-time notifications)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Sentry (Error tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Stripe (Billing - if implementing paid plans)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Performance & Optimization ───────────────────────────────────────────────

# View/Config/Route caching - enable after deployment
# php artisan config:cache
# php artisan route:cache
# php artisan view:cache

# OPcache - ensure enabled in php.ini for production
# opcache.enable=1
# opcache.memory_consumption=128
# opcache.interned_strings_buffer=8
# opcache.max_accelerated_files=10000

# ═════════════════════════════════════════════════════════════════════════════
# Production Deployment Checklist
# ═════════════════════════════════════════════════════════════════════════════
#
# [ ] Set APP_ENV=production
# [ ] Set APP_DEBUG=false
# [ ] Generate APP_KEY: php artisan key:generate
# [ ] Configure database credentials
# [ ] Set up Redis (or use database queue/cache)
# [ ] Configure mail settings
# [ ] Set up SSL/TLS certificates
# [ ] Configure firewall rules
# [ ] Set file permissions: storage/ and bootstrap/cache/ writable
# [ ] Run migrations: php artisan migrate --force
# [ ] Seed super admin: php artisan db:seed --class=SuperAdminSeeder
# [ ] Cache config: php artisan config:cache
# [ ] Cache routes: php artisan route:cache
# [ ] Cache views: php artisan view:cache
# [ ] Set up queue workers: php artisan queue:work
# [ ] Set up cron job for scheduler: * * * * * php artisan schedule:run
# [ ] Configure backups (database + storage)
# [ ] Set up monitoring (logs, uptime, errors)
# [ ] Test all critical features
#
# ═════════════════════════════════════════════════════════════════════════════
