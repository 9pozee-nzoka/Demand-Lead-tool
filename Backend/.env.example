# ─────────────────────────────────────────────────────────────────────────────
# DemandLead — Environment Configuration Template
# Copy this to .env and fill in your values before running the app.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="DemandLead"
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.demandlead.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Use 'debug' for local development only

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demand_lead
DB_USERNAME=demand_lead_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.demandlead.io
SESSION_SECURE_COOKIE=true

# ── Queue & Cache (Redis) ─────────────────────────────────────────────────────
# Use database for local dev; switch to redis for production
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Optional: use separate DB numbers per concern
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@demandlead.io"
MAIL_FROM_NAME="DemandLead"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://app.demandlead.io

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=app.demandlead.io

# ── Horizon (Queue Dashboard) ─────────────────────────────────────────────────
HORIZON_BASIC_AUTH_USERNAME=admin
HORIZON_BASIC_AUTH_PASSWORD=Pozee@5268            # Set a strong password

# ── Demand Engine ─────────────────────────────────────────────────────────────
DEMAND_REQUEST_DELAY_MS=1200      # ms between Google Trends API requests
DEMAND_RISING_THRESHOLD=20        # growth % to classify as RISING
DEMAND_RAPID_THRESHOLD=50         # growth % to classify as RAPIDLY_RISING
DEMAND_SPIKE_THRESHOLD=100        # growth % to classify as SPIKE
DEMAND_DECLINING_THRESHOLD=-20    # growth % to classify as DECLINING
DEMAND_ALERT_MIN_SCORE=60         # minimum opportunity score to fire an alert

# ── Africa's Talking (SMS — Sprint 9) ─────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=

# ── OpenAI (AI Explanations — Sprint 8+) ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── AWS S3 (file storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=demandlead-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Super Admin Seed ──────────────────────────────────────────────────────────
# Credentials used by db:seed --class=SuperAdminSeeder
SUPER_ADMIN_NAME="Your Name"
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe@1234
